# Database Configuration
DB_SYNCHRONIZE=false
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=stock_gem

# JWT (required — min 32 chars; no placeholders; generate: openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Superadmin (pnpm run seed:superadmin)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Admin

# Auth rate limiting (requests per IP per window)
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10

# Uploads (local dev; prod: mount volume e.g. /data/uploads)
UPLOAD_DEST=uploads
UPLOAD_MAX_FILE_SIZE_BYTES=5242880

# Environment
NODE_ENV=development
PORT=3500
