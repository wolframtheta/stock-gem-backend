# Database Configuration
DB_SYNCHRONIZE=false
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=stock_gem

# JWT (required — min 32 chars; no placeholders; generate: openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Superadmin (pnpm run seed:superadmin)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Admin

# Auth rate limiting (requests per IP per window)
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10

# Carpeta final al disc (local: data/images | Coolify volum: /data/images)
UPLOAD_DEST=data/images
# Path URL públic (static GET + path guardat a BD; POST = {API}/… mateix path)
UPLOAD_PUBLIC_PATH=/uploads/images
UPLOAD_MAX_FILE_SIZE_BYTES=5242880

# Environment
NODE_ENV=development
PORT=3500
CORS_ORIGIN=http://localhost:4300
# `api` = accés directe (local). Buit = darrere proxy que ja exposa /api (Coolify strip).
API_GLOBAL_PREFIX=api
